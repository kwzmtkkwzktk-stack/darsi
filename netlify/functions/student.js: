const { MongoClient } = require("mongodb");
let p;
const db = () => (p ||= new MongoClient(process.env.MONGODB_URI).connect().then(c => c.db("darsi")));
const r = (s, o) => ({ statusCode: s, headers: { "content-type": "application/json", "cache-control": "no-store" }, body: JSON.stringify(o || {}) });

exports.handler = async (event) => {
  try {
    const code = String((event.queryStringParameters || {}).code || "").replace(/\D/g, "");
    if (code.length < 4) return r(404);
    const d = await (await db()).collection("students").findOne({ _id: code });
    if (!d) return r(404);
    return r(200, { n: d.n, g: d.g, x: d.x || {}, ab: d.ab || [] });
  } catch (e) {
    return r(500);
  }
};
